<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Melody Tiles Pro - YouTube Edition</title>
    <style>
        body {
            margin: 0;
            background: #1a1a1a;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            color: white;
            touch-action: none; 
        }
        #gameContainer {
            position: relative;
            width: 400px;
            height: 600px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
            border-radius: 8px;
            overflow: hidden;
            background: #2d2d2d;
        }
        canvas {
            display: block;
            background: #1e1e1e;
            z-index: 2;
            position: relative;
        }
        /* Hidden video container behind the canvas so audio plays and video stays subtle */
        #videoWrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            opacity: 0.15; /* Subdued background video effect */
            pointer-events: none;
        }
        #uiLayer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 3;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 12px;
            background: rgba(30,30,30,0.85);
        }
        .interactive {
            pointer-events: auto !important;
        }
        .btn {
            padding: 12px 25px;
            color: white;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
            text-align: center;
            border: none;
            font-size: 15px;
            width: 240px;
        }
        #pcBtn { background: #3278f0; box-shadow: 0 4px 15px rgba(50,120,240,0.4); }
        #mobileBtn { background: #e68c0a; box-shadow: 0 4px 15px rgba(230,140,10,0.4); }
        
        .diff-btn { display: none; }
        #easyBtn { background: #28a745; box-shadow: 0 4px 15px rgba(40,167,69,0.4); }
        #normalBtn { background: #ffc107; color: #1a1a1a; box-shadow: 0 4px 15px rgba(255,193,7,0.4); }
        #hardBtn { background: #dc3545; box-shadow: 0 4px 15px rgba(220,53,69,0.4); }

        .song-btn { display: none; background: #6f42c1; box-shadow: 0 4px 15px rgba(111,66,193,0.4); font-size: 14px; }
        
        .btn:hover {
            transform: scale(1.03);
            filter: brightness(1.1);
        }
        #loadingText {
            font-size: 18px;
            color: #3278f0;
            font-weight: bold;
            display: none;
            text-align: center;
        }
    </style>
</head>
<body>

    <div id="gameContainer">
        <div id="videoWrapper">
            <div id="ytPlayer"></div>
        </div>

        <canvas id="gameCanvas" width="400" height="600"></canvas>
        
        <div id="uiLayer">
            <button id="pcBtn" class="btn interactive">Play on PC (D F J K)</button>
            <button id="mobileBtn" class="btn interactive">Play on Mobile (Touch)</button>

            <button id="easyBtn" class="btn diff-btn interactive">Easy</button>
            <button id="normalBtn" class="btn diff-btn interactive">Normal</button>
            <button id="hardBtn" class="btn diff-btn interactive">Hard</button>

            <button id="song0" class="btn song-btn interactive">完璧 - YUKI</button>
            <button id="song1" class="btn song-btn interactive">日落時 - YUKI</button>
            <button id="song2" class="btn song-btn interactive">女神之翼 - Yuki 羅毓儀</button>
            <button id="song3" class="btn song-btn interactive">新紮特工 - 片尾曲</button>

            <div id="loadingText">Connecting to YouTube API...<br>Please wait.</div>
        </div>
    </div>

    <script src="https://www.youtube.com/iframe_api"></script>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");
        
        const pcBtn = document.getElementById("pcBtn");
        const mobileBtn = document.getElementById("mobileBtn");
        const easyBtn = document.getElementById("easyBtn");
        const normalBtn = document.getElementById("normalBtn");
        const hardBtn = document.getElementById("hardBtn");
        const diffButtons = [easyBtn, normalBtn, hardBtn];

        const songButtons = [
            document.getElementById("song0"),
            document.getElementById("song1"),
            document.getElementById("song2"),
            document.getElementById("song3")
        ];
        const loadingText = document.getElementById("loadingText");

        const TRACK_KEYS = ['d', 'f', 'j', 'k'];
        const COLUMN_WIDTH = 400 / 4;
        const TILE_HEIGHT = 100;
        const HIT_LINE_Y = 600 - 120;

        // Controlled speed adjustments
        const DIFF_CONFIGS = {
            EASY:   { scrollDuration: 1.6, densityMultiplier: 1.5 },
            NORMAL: { scrollDuration: 1.2, densityMultiplier: 1.0 },
            HARD:   { scrollDuration: 0.8, densityMultiplier: 0.6 }
        };

        // Static Track Lists with mapped accurate rhythm chart intervals (represented as seconds)
        const SONG_DATABASE = [
            { 
                id: "d1mmZw9fG8A", // 完璧
                baseBeats: [12.2, 13.5, 15.1, 16.6, 18.2, 19.8, 21.3, 24.1, 25.5, 27.0, 28.5, 30.1, 33.4, 36.2, 38.5, 41.2, 44.0, 48.1, 51.3, 53.0, 55.2, 60.1, 64.2]
            },
            { 
                id: "2FTv2ywAnCQ", // 日落時
                baseBeats: [18.1, 20.3, 22.5, 25.0, 28.2, 31.4, 35.0, 40.1, 45.4, 49.0, 54.2, 58.0, 63.1, 66.4, 70.2, 75.0, 82.1, 88.3, 94.0, 102.1]
            },
            { 
                id: "Fnkz5GaeAXs", // 女神之翼
                baseBeats: [5.2, 7.1, 9.4, 11.2, 14.0, 16.5, 18.2, 22.1, 25.4, 29.1, 33.0, 37.4, 41.2, 45.0, 49.3, 53.1, 57.0, 62.1, 66.4, 72.1]
            },
            { 
                id: "wo3qdnpQVYM", // 新紮特工
                baseBeats: [2.1, 4.3, 6.5, 8.8, 11.0, 13.2, 15.4, 18.0, 21.2, 24.5, 28.0, 31.2, 35.4, 40.1, 44.2, 48.0, 52.1, 56.4, 60.2, 64.1]
            }
        ];

        let currentState = "MENU"; 
        let selectedDevice = null;
        let selectedDifficulty = "NORMAL"; 
        let scrollDuration = 1.2;          
        let activeTiles = [];
        let score = 0;
        let hp = 100;
        
        let activeInputs = [false, false, false, false];
        let feedbackText = "";
        let feedbackColor = "";
        let feedbackTimer = 0;
        
        let player = null; 
        let ytApiReady = false;
        let chosenSongIdx = null;

        // Global callback required by the YouTube Framework
        window.onYouTubeIframeAPIReady = function() {
            ytApiReady = true;
        };

        pcBtn.onclick = () => { selectedDevice = "PC"; showDifficultySelection(); };
        mobileBtn.onclick = () => { selectedDevice = "MOBILE"; showDifficultySelection(); };

        function showDifficultySelection() {
            pcBtn.style.display = "none";
            mobileBtn.style.display = "none";
            diffButtons.forEach(btn => btn.style.display = "block");
        }

        easyBtn.onclick = () => selectDifficulty("EASY");
        normalBtn.onclick = () => selectDifficulty("NORMAL");
        hardBtn.onclick = () => selectDifficulty("HARD");

        function selectDifficulty(diff) {
            selectedDifficulty = diff;
            scrollDuration = DIFF_CONFIGS[diff].scrollDuration;
            diffButtons.forEach(btn => btn.style.display = "none");
            songButtons.forEach(btn => btn.style.display = "block");
        }

        // Loop linking song selection keys
        songButtons.forEach((btn, index) => {
            btn.onclick = () => loadYoutubeSongTrack(index);
        });

        function loadYoutubeSongTrack(idx) {
            if(!ytApiReady) {
                alert("YouTube system still loading. Please hold on a brief second.");
                return;
            }
            chosenSongIdx = idx;
            songButtons.forEach(btn => btn.style.display = "none");
            loadingText.style.display = "block";
            
            document.getElementById("uiLayer").style.background = "transparent";

            // If an instance player exists, pull and swap context parameters instantly
            if (player) {
                player.loadVideoById(SONG_DATABASE[idx].id);
                prepareTrackDataData(idx);
            } else {
                // Initialize the player framework
                player = new YT.Player('ytPlayer', {
                    height: '100%',
                    width: '100%',
                    videoId: SONG_DATABASE[idx].id,
                    playerVars: {
                        'autoplay': 1,
                        'controls': 0,
                        'disablekb': 1,
                        'fs': 0,
                        'rel': 0,
                        'modestbranding': 1
                    },
                    events: {
                        'onReady': onPlayerReady,
                        'onStateChange': onPlayerStateChange
                    }
                });
            }
        }

        function onPlayerReady(event) {
            prepareTrackDataData(chosenSongIdx);
        }

        function prepareTrackDataData(idx) {
            const song = SONG_DATABASE[idx];
            const multiplier = DIFF_CONFIGS[selectedDifficulty].densityMultiplier;
            let rawTimestamps = [];

            // Algorithmic scale matching user difficulties setting arrays
            song.baseBeats.forEach(beat => {
                rawTimestamps.push(beat);
                if (multiplier < 1.0) { // If hard, inject an intermediate note pattern
                    rawTimestamps.push(beat + (scrollDuration * 0.4));
                }
            });
            
            rawTimestamps.sort((a,b) => a - b);

            // Process data sets into Single, Double, and Hold patterns
            activeTiles = [];
            for (let i = 0; i < rawTimestamps.length; i++) {
                let target = rawTimestamps[i];
                let roll = Math.random();
                let column = Math.floor(Math.random() * 4);

                if (roll < 0.65) {
                    activeTiles.push({ spawnTime: target - scrollDuration, targetTime: target, col: column, hit: false, missed: false, type: "SINGLE" });
                } else if (roll < 0.85) {
                    activeTiles.push({ spawnTime: target - scrollDuration, targetTime: target, col: column, hit: false, missed: false, type: "SINGLE" });
                    let altCol = (column + 1) % 4;
                    activeTiles.push({ spawnTime: target - scrollDuration, targetTime: target, col: altCol, hit: false, missed: false, type: "SINGLE" });
                } else {
                    let holdLen = 0.5 + Math.random() * 0.7;
                    activeTiles.push({ spawnTime: target - scrollDuration, targetTime: target, col: column, hit: false, missed: false, type: "HOLD", holdDuration: holdLen, holdCompleted: false });
                    if(i + 1 < rawTimestamps.length && rawTimestamps[i+1] < target + holdLen) i++;
                }
            }

            loadingText.style.display = "none";
            score = 0;
            hp = 100;
            currentState = "PLAYING";
            player.playVideo();
        }

        function onPlayerStateChange(event) {
            // If track finishes playing naturally, cycle state routing loops
            if (event.data === YT.PlayerState.ENDED) {
                endGameSession();
            }
        }

        function processHitRegister(trackIndex) {
            if (currentState !== "PLAYING") return;
            // Fetch current runtime position straight from the YouTube stream tracking layers
            const currentTrackTime = player.getCurrentTime();
            let handled = false;
            
            for (let t of activeTiles) {
                if (t.col === trackIndex && !t.hit && !t.missed) {
                    const timeDiff = Math.abs(currentTrackTime - t.targetTime);
                    if (timeDiff < 0.16) { 
                        t.hit = true;
                        handled = true;
                        
                        if (t.type === "SINGLE") {
                            triggerFeedback(timeDiff < 0.06 ? "PERFECT!" : "GREAT", timeDiff < 0.06 ? "#28a745" : "#3278f0", timeDiff < 0.06 ? 150 : 75);
                        } else if (t.type === "HOLD") {
                            triggerFeedback("HOLD!", "#e68c0a", 50);
                        }
                        break;
                    }
                }
            }
            if (!handled) {
                triggerFeedback("MISS", "#dc3545", 0);
                hp -= 5;
            }
        }

        function triggerFeedback(text, color, points) {
            feedbackText = text; feedbackColor = color; feedbackTimer = 25; score += points;
        }

        // Inputs routing arrays
        window.addEventListener("keydown", (e) => {
            if (currentState !== "PLAYING" || selectedDevice !== "PC" || e.repeat) return;
            const idx = TRACK_KEYS.indexOf(e.key.toLowerCase());
            if (idx !== -1) { activeInputs[idx] = true; processHitRegister(idx); }
        });

        window.addEventListener("keyup", (e) => {
            const idx = TRACK_KEYS.indexOf(e.key.toLowerCase());
            if (idx !== -1) activeInputs[idx] = false;
        });

        canvas.addEventListener("touchstart", (e) => {
            if (currentState !== "PLAYING" || selectedDevice !== "MOBILE") return;
            e.preventDefault(); 
            const rect = canvas.getBoundingClientRect();
            for (let i = 0; i < e.changedTouches.length; i++) {
                const touch = e.changedTouches[i];
                const relativeX = ((touch.clientX - rect.left) / rect.width) * canvas.width;
                const trackIdx = Math.floor(relativeX / COLUMN_WIDTH);
                if (trackIdx >= 0 && trackIdx < 4) { activeInputs[trackIdx] = true; processHitRegister(trackIdx); }
            }
        }, { passive: false });

        canvas.addEventListener("touchend", (e) => {
            const rect = canvas.getBoundingClientRect();
            for (let i = 0; i < e.changedTouches.length; i++) {
                const touch = e.changedTouches[i];
                const relativeX = ((touch.clientX - rect.left) / rect.width) * canvas.width;
                const trackIdx = Math.floor(relativeX / COLUMN_WIDTH);
                if (trackIdx >= 0 && trackIdx < 4) activeInputs[trackIdx] = false;
            }
        });

        function endGameSession() {
            currentState = "MENU";
            if (player) player.pauseVideo();
            document.getElementById("uiLayer").style.background = "rgba(30,30,30,0.85)";
            pcBtn.style.display = "block";
            mobileBtn.style.display = "block";
            selectedDevice = null;
        }

        function update() {
            ctx.clearRect(0, 0, 400, 600);
            
            // Grid canvas lines draws
            ctx.strokeStyle = "#333333"; ctx.lineWidth = 2;
            for (let i = 1; i < 4; i++) {
                ctx.beginPath(); ctx.moveTo(i * COLUMN_WIDTH, 0); ctx.lineTo(i * COLUMN_WIDTH, 600); ctx.stroke();
            }
            
            // Pressed structural column tracking highlights render
            for (let i = 0; i < 4; i++) {
                if (activeInputs[i] && currentState === "PLAYING") {
                    ctx.fillStyle = "rgba(255, 255, 255, 0.1)"; ctx.fillRect(i * COLUMN_WIDTH, 0, COLUMN_WIDTH, 600);
                }
            }

            ctx.strokeStyle = "rgba(50, 120, 240, 0.8)"; ctx.lineWidth = 4;
            ctx.beginPath(); ctx.moveTo(0, HIT_LINE_Y); ctx.lineTo(400, HIT_LINE_Y); ctx.stroke();

            if (currentState === "MENU") {
                ctx.fillStyle = "#aaaaaa"; ctx.font = "16px Arial"; ctx.textAlign = "center";
                if (!selectedDevice) {
                    ctx.fillText("Select your platform to play", 200, 250);
                }
            }

            if (currentState === "PLAYING" && player && typeof player.getCurrentTime === "function") {
                const currentTrackTime = player.getCurrentTime();
                const tileColors = ["#ff6b6b", "#feca57", "#48dbfb", "#1dd1a1"];

                for (let t of activeTiles) {
                    if (currentTrackTime >= t.spawnTime) {
                        const progress = (currentTrackTime - t.spawnTime) / scrollDuration;
                        const headY = progress * HIT_LINE_Y - TILE_HEIGHT;

                        if (currentTrackTime > t.targetTime + 0.16 && !t.hit && !t.missed) {
                            t.missed = true; hp -= 6; triggerFeedback("MISS", "#dc3545", 0);
                        }

                        if (t.type === "SINGLE" && !t.hit && headY < 600) {
                            ctx.fillStyle = t.missed ? "#442222" : tileColors[t.col];
                            ctx.fillRect(t.col * COLUMN_WIDTH + 4, headY, COLUMN_WIDTH - 8, TILE_HEIGHT);
                        } 
                        else if (t.type === "HOLD") {
                            const tailProgress = (currentTrackTime - (t.spawnTime + t.holdDuration)) / scrollDuration;
                            const tailY = tailProgress * HIT_LINE_Y - TILE_HEIGHT;

                            if (t.hit && !t.holdCompleted) {
                                if (activeInputs[t.col]) {
                                    score += 1;
                                    if (currentTrackTime >= t.targetTime + t.holdDuration) {
                                        t.holdCompleted = true; triggerFeedback("PERFECT HOLD!", "#28a745", 100);
                                    }
                                } else {
                                    t.holdCompleted = true; t.missed = true; hp -= 8; triggerFeedback("DROPPED", "#dc3545", 0);
                                }
                            }

                            if (!t.holdCompleted && tailY < 600) {
                                let startRenderY = t.hit ? HIT_LINE_Y - TILE_HEIGHT : headY;
                                let holdHeight = tailY - startRenderY;

                                if (holdHeight < 0) {
                                    ctx.fillStyle = t.missed ? "rgba(68,34,34,0.4)" : "rgba(230, 140, 10, 0.4)";
                                    ctx.fillRect(t.col * COLUMN_WIDTH + 15, startRenderY + TILE_HEIGHT, COLUMN_WIDTH - 30, Math.abs(holdHeight) - TILE_HEIGHT);
                                    if (!t.hit) {
                                        ctx.fillStyle = t.missed ? "#442222" : tileColors[t.col];
                                        ctx.fillRect(t.col * COLUMN_WIDTH + 4, headY, COLUMN_WIDTH - 8, TILE_HEIGHT);
                                    }
                                    ctx.fillStyle = "#e68c0a"; ctx.fillRect(t.col * COLUMN_WIDTH + 4, tailY, COLUMN_WIDTH - 8, 15);
                                }
                            }
                        }
                    }
                }

                // Display UI stats strip overhead overlays
                ctx.fillStyle = "rgba(0,0,0,0.5)"; ctx.fillRect(0, 0, 400, 50);
                ctx.fillStyle = hp < 30 ? "#dc3545" : "#28a745"; ctx.fillRect(20, 18, Math.max(0, hp) * 1.5, 14);
                ctx.fillStyle = "#ffffff"; ctx.font = "bold 16px Arial"; ctx.textAlign = "left";
                ctx.fillText("SCORE: " + score, 200, 30);

                if (feedbackTimer > 0) {
                    ctx.fillStyle = feedbackColor; ctx.font = "bold 26px Arial"; ctx.textAlign = "center";
                    ctx.fillText(feedbackText, 200, 300); feedbackTimer--;
                }

                if (hp <= 0) endGameSession();
            }
            requestAnimationFrame(update);
        }
        update();
    </script>
</body>
</html>
